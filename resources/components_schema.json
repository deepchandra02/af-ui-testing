{
  "components": [
    {
      "name": "Textbox",
      "type": "text_input",
      "html_snippet": "<input type='text' id='username-input' placeholder='XXXX' aria-label='Numeric Box' />",
      "variations": {
        "character_limit": {
          "exists": true,
          "triggered_by": "placeholder contains only X's",
          "limit_value": "_char_limit_",
          "description": "Enforces a maximum character length based on the number of X's in placeholder."
        },
        "numeric_only": {
          "exists": true,
          "triggered_by": "aria-label='Numeric Box'",
          "description": "Restricts input to numeric values only."
        }
      },
      "testing_scenarios": [
        {
          "scenario": "Character limit enforced",
          "preconditions": [
            "variations.character_limit.exists == true",
            "placeholder matches 'X+'"
          ],
          "steps": [
            {
              "action": "enter_text",
              "parameters": { "value": "_exceed_limit_" },
              "expected_result": "input is truncated or ignored beyond character limit"
            },
            {
              "action": "enter_text",
              "parameters": { "value": "_below_limit_" },
              "expected_result": "input accepted but may trigger 'input too short' validation"
            },
            {
              "action": "enter_text",
              "parameters": { "value": "_exact_limit_" },
              "expected_result": "input accepted without error"
            }
          ]
        },
        {
          "scenario": "Numeric input only",
          "preconditions": ["variations.numeric_only.exists == true"],
          "steps": [
            {
              "action": "enter_text",
              "parameters": { "value": "1234" },
              "expected_result": "input accepted without error"
            },
            {
              "action": "enter_text",
              "parameters": { "value": "1234a" },
              "expected_result": "input rejected or triggers error message"
            },
            {
              "action": "enter_text",
              "parameters": { "value": "!@#%" },
              "expected_result": "input rejected or triggers error message"
            }
          ]
        },
        {
          "scenario": "Generic input test",
          "preconditions": [],
          "steps": [
            {
              "action": "enter_text",
              "parameters": { "value": "TestInput" },
              "expected_result": "input accepted without error"
            }
          ]
        }
      ]
    }
  ]
}
